<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    tools:context=".MainActivity"
    tools:ignore="HardcodedText">

    <Toolbar
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:title="@string/app_name"
        android:titleTextColor="@color/md_theme_onBackground" />

    <View
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/from_asset"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Codul de etică" />

    <Button
        android:id="@+id/from_asset_pdfjs"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Deschide cu PDF.js" />

    <Button
        android:id="@+id/from_storage"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Load from storage" />



    <Button
        android:id="@+id/from_url"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Regulament financiar 2024" />


    <Button
        android:id="@+id/from_asset_doc"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Deschide DOC din assets" />

    <Button
        android:id="@+id/fromAssetDocxHtml"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Deschide DOCX ca HTML" />


    <View
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1" />



</LinearLayout>